# Endereço público (usado nos links do painel enviados ao n8n)
PUBLIC_URL=https://catalogo.anilpiscinas.com.br

# Acesso ao painel /admin
ADMIN_USER=anil
ADMIN_PASSWORD=troque-esta-senha
# Texto aleatório longo (ex.: openssl rand -hex 32)
SESSION_SECRET=troque-por-um-texto-aleatorio

# WhatsApp que recebe o código quando o link não tem ?v=vendedora (só números, com 55 + DDD)
WHATSAPP_PADRAO=553799261553

# Opcional: webhook do n8n chamado a cada orçamento enviado
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Prefixo do código do orçamento (ANL-XXXXX)
CODE_PREFIX=ANL
